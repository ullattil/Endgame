# Required: get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: only needed if you want the script to draft/send application emails.
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords), not your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
